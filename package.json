{
  "name": "thunderbird-teams-provider",
  "version": "1.0.0",
  "description": "Microsoft Teams chat integration for Thunderbird",
  "private": true,
  "scripts": {
    "build": "web-ext build --overwrite-dest --filename={name}-{version}.xpi --ignore-files=package.json --ignore-files=package-lock.json --ignore-files=web-ext-config.json --ignore-files=*.md",
    "lint": "web-ext lint",
    "lint:eslint": "eslint background/ popup/ options/ tests/",
    "lint:sarif": "eslint background/ popup/ options/ tests/ --format @microsoft/eslint-formatter-sarif --output-file eslint-results.sarif || true",
    "start": "web-ext run --target=thunderbird",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration"
  },
  "devDependencies": {
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "eslint": "^10.3.0",
    "eslint-plugin-security": "^4.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "web-ext": "^10.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
